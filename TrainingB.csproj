<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Selenium.WebDriver" Version="4.25.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="TrainingB.Core\TrainingB.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude duplicate files - use TrainingB.Core instead -->
    <Compile Remove="Forms\Test\**" />
    <Compile Remove="Services\**" />
    <Compile Remove="TrainingB.Web\**" />
    <Compile Remove="TrainingB.Core\**" />
    <EmbeddedResource Remove="Forms\Test\**" />
    <EmbeddedResource Remove="Services\**" />
    <EmbeddedResource Remove="TrainingB.Web\**" />
    <EmbeddedResource Remove="TrainingB.Core\**" />
    <None Remove="Forms\Test\**" />
    <None Remove="Services\**" />
    <None Remove="TrainingB.Web\**" />
    <None Remove="TrainingB.Core\**" />
  </ItemGroup>

</Project>